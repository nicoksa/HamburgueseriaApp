<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="HamburgueseriaApp.Views.VentasView"
             av:DesignHeight="185.571" av:DesignWidth="708.392">

    <Grid Margin="24,10,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushPanel}" />
            <DatePicker SelectedDate="{Binding Desde}" Width="150" Margin="0,0,20,0"
            CalendarStyle="{StaticResource CalendarOscuroStyle}"/>
            <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushPanel}"/>
            <DatePicker SelectedDate="{Binding Hasta}" Width="150" Margin="0,0,20,0"
            CalendarStyle="{StaticResource CalendarOscuroStyle}"/>
            <Button Content="Hoy" Style="{StaticResource BotonAccion}" Command="{Binding FiltrarHoyCommand}"/>
            <Button Content="🔍 Ver detalle" Style="{StaticResource BotonAccion}" Command="{Binding VerDetalleCommand}"/>
            <Button Content="🖨️ Reimprimir" Style="{StaticResource BotonAccion}" Command="{Binding ReimprimirCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Pedidos}" SelectedItem="{Binding Seleccionado}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nº Pedido" Binding="{Binding NumeroPedido}" Width="Auto"/>
                <DataGridTextColumn Header="Fecha y hora" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=$ \{0:N0\}}" Width="*"/>
                <DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPago}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<Window x:Class="HamburgueseriaApp.Views.ProductoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">

    <Window.Resources>
        <Style x:Key="ComboBoxOscuroLocal" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushPanelClaro}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoPrimario}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" x:Name="ContentSite"
                                                    Content="{TemplateBinding SelectionBoxItem}"
                                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                    Margin="{TemplateBinding Padding}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <TextBlock Grid.Column="1" Text="&#9662;" FontSize="14"
                                            Foreground="{StaticResource BrushTextoSecundario}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                                       Focusable="False" PopupAnimation="Slide"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{StaticResource BrushPanel}"
                                            BorderBrush="{StaticResource BrushBorde}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextoPrimario}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="4" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrushAmarillo}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nombre" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" x:Name="TxtNombre" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="Precio (simple)" Margin="0,0,0,6"/>
        <TextBox Grid.Row="3" x:Name="TxtPrecio" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Tipo" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbTipo" Style="{StaticResource ComboBoxOscuroLocal}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" x:Name="PanelVariantes" Margin="0,0,0,16">
            <TextBlock Text="Precios por variante " Margin="0,0,0,6"/>
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Doble" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPrecioDoble"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Triple" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPrecioTriple"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Cuádruple" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPrecioCuadruple"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>

        <CheckBox Grid.Row="6" x:Name="ChkActivo" Content="Activo (visible en Nuevo pedido)"
              FontSize="16" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonAccion}" Click="Cancelar_Click"/>
            <Button Content="Guardar" Style="{StaticResource BotonAccion}" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="HamburgueseriaApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HamburgueseriaApp.ViewModels"
        xmlns:views="clr-namespace:HamburgueseriaApp.Views"
        Title="Big Burger — Sistema de pedidos"
        WindowState="Maximized"
        MinWidth="1100" MinHeight="650"
        FontSize="16">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NuevoPedidoViewModel}">
            <views:NuevoPedidoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
            <views:ProductosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VentasViewModel}">
            <views:VentasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EstadisticasViewModel}">
            <views:EstadisticasView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== MENÚ LATERAL ===================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushPanel}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,24">
                    <TextBlock Text="🍔" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="BIG BURGER" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAmarillo}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="🧾  Nuevo pedido" Style="{StaticResource BotonNav}"
                            Command="{Binding IrANuevoPedidoCommand}"/>
                    <Button Content="🍟  Productos" Style="{StaticResource BotonNav}"
                            Command="{Binding IrAProductosCommand}"/>
                    <Button Content="💵  Ventas" Style="{StaticResource BotonNav}"
                            Command="{Binding IrAVentasCommand}"/>
                    <Button Content="📊  Estadísticas" Style="{StaticResource BotonNav}"
                            Command="{Binding IrAEstadisticasCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== CONTENIDO ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushFondo}" Padding="24,18">
                <TextBlock Text="{Binding TituloActual}" FontSize="26" FontWeight="Bold"/>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding VistaActual}" Margin="0"/>
        </Grid>
    </Grid>
</Window>

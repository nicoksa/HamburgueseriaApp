<ui:FluentWindow x:Class="HamburgueseriaApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HamburgueseriaApp.ViewModels"
        xmlns:views="clr-namespace:HamburgueseriaApp.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Big Burger — Sistema de pedidos"
        WindowState="Maximized"
        MinWidth="1100" MinHeight="650"
        FontSize="16"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <!-- cambia Window.Resources -> FluentWindow.Resources porque cambió el elemento raíz -->
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:NuevoPedidoViewModel}">
            <views:NuevoPedidoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
            <views:ProductosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VentasViewModel}">
            <views:VentasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EstadisticasViewModel}">
            <views:EstadisticasView/>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR (nuevo) =====================. -->

        <ui:TitleBar Grid.Row="0" Title="BIG BURGER — Sistema de pedidos"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== MENÚ LATERAL ===================== -->
            <Border Grid.Column="0" Background="{StaticResource BrushPanel}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="0,24,0,24">
                        <!-- Reemplazamos el emoji 🍔 por un ícono vectorial -->
                        <ui:SymbolIcon Symbol="Food24" FontSize="36"
                                       Foreground="{StaticResource BrushAmarillo}"
                                       HorizontalAlignment="Center"/>
                        <TextBlock Text="BIG BURGER" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAmarillo}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <!-- ui:Button con Icon en vez de emoji dentro del Content de texto -->
                        <ui:Button Content="Nuevo pedido"
                                   Icon="{ui:SymbolIcon ReceiptAdd24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   FontSize="17" FontWeight="SemiBold"
                                   Padding="16,16" Margin="8,4"
                                   Command="{Binding IrANuevoPedidoCommand}"/>

                        <ui:Button Content="Productos"
                                   Icon="{ui:SymbolIcon Food24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   FontSize="17" FontWeight="SemiBold"
                                   Padding="16,16" Margin="8,4"
                                   Command="{Binding IrAProductosCommand}"/>

                        <ui:Button Content="Ventas"
                                   Icon="{ui:SymbolIcon Money24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   FontSize="17" FontWeight="SemiBold"
                                   Padding="16,16" Margin="8,4"
                                   Command="{Binding IrAVentasCommand}"/>

                        <ui:Button Content="Estadísticas"
                                   Icon="{ui:SymbolIcon DataBarVertical24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   FontSize="17" FontWeight="SemiBold"
                                   Padding="16,16" Margin="8,4"
                                   Command="{Binding IrAEstadisticasCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===================== CONTENIDO ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushFondo}" Padding="24,18">
                    <TextBlock Text="{Binding TituloActual}" FontSize="26" FontWeight="Bold"/>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding VistaActual}" Margin="0"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

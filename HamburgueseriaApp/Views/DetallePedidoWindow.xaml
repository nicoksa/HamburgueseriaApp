<Window x:Class="HamburgueseriaApp.Views.DetallePedidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del pedido" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding NumeroPedido, StringFormat='Pedido Nº {0}'}" FontSize="22" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Margin="0,4,0,14">
            <TextBlock Text="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="{StaticResource BrushTextoSecundario}"/>
            <TextBlock x:Name="TxtCliente" Text="{Binding NombreCliente, StringFormat='Cliente: {0}'}" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtTipo" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtDireccion" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushPanelClaro}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Cantidad, StringFormat='{}{0}x'}" FontWeight="Bold" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding NombreProducto}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Observaciones, StringFormat='→ {0}'}" FontStyle="Italic" FontSize="13"
                                               Foreground="{StaticResource BrushAmarillo}" TextWrapping="Wrap"
                                               Visibility="{Binding TieneObservaciones, Converter={StaticResource BoolToVisibleConverter}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='$ {0:N0}'}"
                                           FontWeight="Bold" Foreground="{StaticResource BrushAmarillo}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="PanelObservaciones" Grid.Row="3" Margin="0,10,0,10">
            <TextBlock Text="Observaciones" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Observaciones}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="TOTAL" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Total, StringFormat='$ {0:N0}'}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushAmarillo}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Cerrar" Style="{StaticResource BotonAccion}" Click="Cerrar_Click"/>
        </Grid>
    </Grid>
</Window>
<UserControl x:Class="HamburgueseriaApp.Views.NuevoPedidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:HamburgueseriaApp.Models">

    <Grid Margin="24,0,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== PRODUCTOS ===================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="HAMBURGUESAS" FontWeight="Bold" FontSize="16"
                           Foreground="{StaticResource BrushAmarillo}" Margin="0,4,0,4"/>
                <ItemsControl ItemsSource="{Binding Hamburguesas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Producto}">
                            <Button Style="{StaticResource BotonGrande}"
                                    Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nombre}" FontSize="19" FontWeight="Bold"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0">
                                        <TextBlock FontSize="15"
                                                   Visibility="{Binding SinSimple, Converter={StaticResource BoolToVisibleConverter}}"/>
                                        <TextBlock Text="{Binding PrecioDesde, StringFormat='$ {0:N0}'}" FontSize="15"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="PAPAS Y EXTRAS" FontWeight="Bold" FontSize="16"
                           Foreground="{StaticResource BrushAmarillo}" Margin="0,18,0,4"/>
                <ItemsControl ItemsSource="{Binding PapasYExtras}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Producto}">
                            <Button Style="{StaticResource BotonGrande}"
                                    Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nombre}" FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Precio, StringFormat='$ {0:N0}'}" FontSize="14"
                                               HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="BEBIDAS" FontWeight="Bold" FontSize="16"
                           Foreground="{StaticResource BrushAmarillo}" Margin="0,18,0,4"/>
                <ItemsControl ItemsSource="{Binding Bebidas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Producto}">
                            <Button Style="{StaticResource BotonGrande}"
                                    Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nombre}" FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Precio, StringFormat='$ {0:N0}'}" FontSize="14"
                                               HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== PEDIDO ACTUAL ===================== -->
        <Border Grid.Column="2" Background="{StaticResource BrushPanel}" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0 título -->
                    <RowDefinition Height="*" MinHeight="150"/>
                    <!-- 1 items (nunca baja de 150 px) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2 cliente -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3 tipo + dirección -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4 observaciones -->
                    <RowDefinition Height="Auto"/>
                    <!-- 5 forma de pago -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6 total -->
                    <RowDefinition Height="Auto"/>
                    <!-- 7 botón -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PEDIDO ACTUAL" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>

                <!-- Lista de items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushPanelClaro}" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−" Style="{StaticResource BotonChico}"
                                            Command="{Binding DataContext.DecrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Cantidad}" FontSize="16" FontWeight="Bold"
                                               Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="+" Style="{StaticResource BotonChico}"
                                            Command="{Binding DataContext.IncrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontSize="15" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Observaciones, StringFormat='→ {0}'}" FontSize="12" FontStyle="Italic"
                                               Foreground="{StaticResource BrushAmarillo}" TextWrapping="Wrap"
                                               Visibility="{Binding TieneObservaciones, Converter={StaticResource BoolToVisibleConverter}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='$ {0:N0}'}" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center" Foreground="{StaticResource BrushAmarillo}"/>

                                        <Button Grid.Column="3" Content="📝" Style="{StaticResource BotonChico}" Margin="6,0,0,0"
                                        Command="{Binding DataContext.EditarObservacionItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>

                                        <Button Grid.Column="4" Content="✕" Style="{StaticResource BotonChico}" Margin="6,0,0,0"
                                        Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Text="Tocá un producto de la izquierda para agregarlo"
                   Foreground="{StaticResource BrushTextoSecundario}" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,20,0,0"
                   Visibility="{Binding HayItems, Converter={StaticResource BoolToCollapsedConverter}}"/>

                <!-- Nombre del cliente -->
                <StackPanel Grid.Row="2" Margin="0,8,0,6">
                    <TextBlock Text="Nombre del cliente" FontSize="13"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding NombreCliente, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="15" Padding="8,4"/>
                </StackPanel>

                <!-- Tipo de pedido + dirección -->
                <StackPanel Grid.Row="3" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton Content="RETIRO" GroupName="TipoPedido" FontSize="15" Margin="0,0,20,0"
                             IsChecked="{Binding TipoPedidoSeleccionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Retiro}"/>
                        <RadioButton Content="ENVÍO" GroupName="TipoPedido" FontSize="15"
                             IsChecked="{Binding TipoPedidoSeleccionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Envio}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding EsEnvio, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="Dirección (opcional)" FontSize="13"
                           Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" Padding="8,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Observaciones (compactas: 2 líneas) -->
                <StackPanel Grid.Row="4" Margin="0,0,0,6">
                    <TextBlock Text="Observaciones" FontSize="13"
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="46"
                     FontSize="14" Padding="8,4"
                     VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Forma de pago -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="EFECTIVO" GroupName="FormaPago" FontSize="15" Margin="0,0,20,0"
                         IsChecked="{Binding FormaPagoSeleccionada, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Efectivo}"/>
                    <RadioButton Content="TRANSFERENCIA" GroupName="FormaPago" FontSize="15"
                         IsChecked="{Binding FormaPagoSeleccionada, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Transferencia}"/>
                </StackPanel>

                <!-- Total -->
                <Border Grid.Row="6" Background="{StaticResource BrushPanelClaro}" CornerRadius="8" Padding="12,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='$ {0:N0}'}"
                           FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushAmarillo}"/>
                    </Grid>
                </Border>

                <!-- Botón cobrar (más bajo) -->
                <Button Grid.Row="7" Content="COBRAR E IMPRIMIR" Style="{StaticResource BotonCobrar}"
                MinHeight="56" FontSize="20"
                Command="{Binding CobrarEImprimirCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
